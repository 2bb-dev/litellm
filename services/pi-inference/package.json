{
  "name": "@2bb/pi-inference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/*.test.ts",
    "test:litellm": "node tests/litellm-routing.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write src tests *.json *.md",
    "lint": "prettier --check src tests *.json *.md"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/proper-lockfile": "4.1.4",
    "prettier": "3.5.3",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  }
}
